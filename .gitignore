# Instruction files are private per repository-tiering-policy.md §5.3 —
# both names, because AGENTS.md is canonical and CLAUDE.md is its symlink.
AGENTS.md
CLAUDE.md

# The real config. Only config.example.yaml is tracked — see README "Configuration".
# A topology literal reaching this repo is the one defect that makes the published
# artifact unusable to anyone else (console-policy.md §1.1, §2.3).
config.yaml
config.*.yaml
!config.example.yaml
*.local

# Compiled bytecode. 13 `.pyc` files were tracked in this PUBLIC repo before
# this entry existed, so every diff carried binary churn and every clone shipped
# one machine's interpreter version (cpython-314) as though it were source.
__pycache__/
*.py[cod]
.pytest_cache/

node_modules/
dist/
build/
coverage/
.DS_Store
*.log

# `pip install -e .` build metadata — not part of the published artifact.
*.egg-info/
