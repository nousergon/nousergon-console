[Unit]
Description=nousergon-console (read-only fleet index)
Documentation=https://github.com/nousergon/nousergon-console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/nousergon-console
# Real config.yaml is delivered to this path by deploy-on-merge.sh from SSM
# (never baked into the repo). The process binds loopback only — nginx is the
# sole ingress; Cloudflare Access is the sole authenticator (console-policy §1.2).
Environment=AWS_REGION=us-east-1
ExecStart=/home/ec2-user/nousergon-console/.venv/bin/python -m console serve --config /home/ec2-user/nousergon-console/config.yaml --host 127.0.0.1 --port 5180
Restart=always
RestartSec=5
# shared-application-host-policy.md T0-6 / T1-1 / T1-2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ec2-user/nousergon-console
# /var/cache/nousergon-console, exported as $CACHE_DIRECTORY: finished Step
# Functions executions' describe/history answers persist here so a restart does
# not re-read every retained execution (console/sf_execution_cache.py,
# alpha-engine-config-I11792). Survives restarts; safe to delete (cold start).
CacheDirectory=nousergon-console
# Memory limits are owned by the dashboard box's budget
# (crucible-dashboard infrastructure/systemd/resource-limits/budget.yaml, row
# nousergon-console.service), which installs them as the 99-resource-limits.conf
# drop-in. These two lines mirror that row so the unit is still sanely capped if
# the drop-in is ever missing (fresh box, failed install). They used to read
# MemoryMax=112M (half the live working set) and OOMPolicy=restart, which is not
# an OOMPolicy value (continue|stop|kill), so systemd warned and ignored it on
# every daemon-reload (alpha-engine-config-I7673). Restart=always above already
# restarts the service after an OOM stop.
MemoryHigh=300M
MemoryMax=400M
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
